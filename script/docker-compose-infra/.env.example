# 本文件是模板：复制为 .env 后按需修改。
# docker-compose.yml 已内置与下方一致的默认值，不创建 .env 也能直接启动。
# 这些是开发测试环境的默认凭据，禁止用于生产环境。

# PostgreSQL（ParadeDB：PostgreSQL 17 + pgvector + pg_search）
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_DB=ruoyi-vue-pro
POSTGRES_PORT=5432

# Redis（开发者确认：沿用项目默认，不设置密码；plain Redis 7.0 无向量模块）
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=rabbit
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
