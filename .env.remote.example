# 远程联调环境变量模板（spring profile: remote）
# 使用方法：复制为 .env.remote 后按需修改。.env.remote 已被 .gitignore 忽略，不会提交。
# 优先级：操作系统环境变量 > .env.remote > application-remote.yaml 中的默认值。
# 注意：本文件只放开发测试环境的默认凭据，禁止在仓库中提交真实生产密钥。

# --- PostgreSQL（192.168.0.23）---
YUDAO_DB_HOST=192.168.0.23
YUDAO_DB_PORT=5432
YUDAO_DB_NAME=ruoyi-vue-pro
YUDAO_DB_USERNAME=root
YUDAO_DB_PASSWORD=123456

# --- Redis（192.168.0.23，无密码，AOF 已开启）---
YUDAO_REDIS_HOST=192.168.0.23
YUDAO_REDIS_PORT=6379
# 无密码环境保持为空；YAML 中 Redis password 行默认注释（Redisson 空字符串密码会触发 AUTH 报错）
YUDAO_REDIS_PASSWORD=

# --- RabbitMQ（192.168.0.23，yudao-mini 默认不依赖，保留配置）---
YUDAO_RABBITMQ_HOST=192.168.0.23
YUDAO_RABBITMQ_PORT=5672
YUDAO_RABBITMQ_USERNAME=rabbit
YUDAO_RABBITMQ_PASSWORD=rabbit

# --- 开关 ---
YUDAO_SECURITY_MOCK_ENABLE=true
YUDAO_CAPTCHA_ENABLE=false
YUDAO_ACCESS_LOG_ENABLE=false

# --- MinIO（192.168.0.23）---
# 应用启动不直接读取这些变量；它们与 infra_file_config 中 MinIO 主配置保持一致，
# 便于在后台维护文件配置时复制使用。
YUDAO_MINIO_ENDPOINT=http://192.168.0.23:9000
YUDAO_MINIO_BUCKET=yudao
YUDAO_MINIO_ACCESS_KEY=minioadmin
YUDAO_MINIO_SECRET_KEY=minioadmin
YUDAO_MINIO_DOMAIN=http://192.168.0.23:9000/yudao
YUDAO_MINIO_ENABLE_PATH_STYLE=true
YUDAO_MINIO_ENABLE_PUBLIC_ACCESS=true
