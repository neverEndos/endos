# 板端远程中间件环境变量模板（systemd EnvironmentFile 格式）
#
# 用法：复制到板端 /etc/yudao/env.remote，权限 0600、属主 root：
#   sudo install -o root -g root -m 0600 deploy/env.example /etc/yudao/env.remote
#   sudoedit /etc/yudao/env.remote
#
# 注意：
# 1. 本模板只保留开发/联调环境的占位值，真实密码与密钥禁止提交到仓库。
# 2. systemd EnvironmentFile 不支持行尾注释，注释必须独占一行；值不要加引号。
# 3. 优先级：systemd EnvironmentFile（即操作系统环境变量）> 仓库根 .env.remote
#    > yudao-server/src/main/resources/application-remote.yaml 中的默认值。
# 4. 本文件由 systemd 直接注入，不依赖 Spring 的 spring.config.import；板端
#    不需要再创建仓库根目录下的 .env.remote。
# 5. 变量名必须与 application-remote.yaml 中的 ${...} 占位符一致。

# --- Spring profile ---
# 选择 application-remote.yaml（端口 48080、PostgreSQL 数据源、Redis 配置等）。
# systemd 单元的 ExecStart 已带 --spring.profiles.active=remote；此处保留同等设置，
# 便于手工直接运行 jar，二者其一即可。
SPRING_PROFILES_ACTIVE=remote

# --- PostgreSQL（局域网 192.168.0.23）---
# 数据库 yudao_board 需事先手工创建；sql/postgresql 下的脚本不会建库。
YUDAO_DB_HOST=192.168.0.23
YUDAO_DB_PORT=5432
YUDAO_DB_NAME=yudao_board
# 仅 dev/联调环境允许直接使用 root 超级用户；上线前应改为独立低权限账号。
YUDAO_DB_USERNAME=root
YUDAO_DB_PASSWORD=123456

# --- Redis（同主机，无密码，使用 db 1）---
YUDAO_REDIS_HOST=192.168.0.23
YUDAO_REDIS_PORT=6379
# 无密码环境必须留空；application-remote.yaml 中 password 行默认注释，
# 空字符串密码会让 Redisson 发送 AUTH，对无密码 Redis 报错。
YUDAO_REDIS_PASSWORD=
# 覆盖 application-remote.yaml 中写死的 database: 0；
# Spring Boot 松散绑定，SPRING_DATA_REDIS_DATABASE 等价于 spring.data.redis.database。
# 已验证 OAuth2 token key 落在 db 1（redis-cli -n 1 执行 SELECT 1 后 DBSIZE=2）。
SPRING_DATA_REDIS_DATABASE=1

# --- PostgreSQL：必须关闭 Druid 预编译语句缓存 ---
# 否则登录接口约 50% 概率返回 code=500 系统异常，后端日志出现：
#   org.postgresql.util.PSQLException: This statement has been closed
# 原因：Druid 连接池缓存了 PostgreSQL 服务端预编译语句，语句被服务端关闭后
# 连接仍复用旧句柄。以下两项与 application-remote.yaml 中的
# dynamic.druid.pool-prepared-statements / max-pool-prepared-statement-per-connection-size
# 对应；实测设置后连续 10 次登录全部成功。
SPRING_DATASOURCE_DYNAMIC_DRUID_POOL_PREPARED_STATEMENTS=false
SPRING_DATASOURCE_DYNAMIC_DRUID_MAX_POOL_PREPARED_STATEMENT_PER_CONNECTION_SIZE=0

# --- 安全 / 验证码 / 访问日志开关 ---
# mock 会跳过真实鉴权，仅限内网联调；上线前必须改为 false 并配置真实账号。
YUDAO_SECURITY_MOCK_ENABLE=true
# 板端前端 VITE_APP_CAPTCHA_ENABLE 已提交为 false，后端保持 false 对齐。
YUDAO_CAPTCHA_ENABLE=false
YUDAO_ACCESS_LOG_ENABLE=false

# --- 日志 ---
# application-remote.yaml 默认写 ${user.home}/logs/yudao-server.log；
# 用 Spring 标准环境变量改到统一目录。需先创建 /var/log/yudao 并归属 alientek。
LOGGING_FILE_NAME=/var/log/yudao/yudao-server.log

# --- JVM 参数（说明，不是环境变量）---
# JVM 参数放在 systemd 单元的 ExecStart 中，见 deploy/systemd/yudao-server.service：
#   -Xms256m -Xmx768m -XX:MaxMetaspaceSize=256m
# 旧板 4GB 内存优先省内存；新板 8GB 可把 -Xmx 调整为 1024m 或 1536m，
# 并同步观察 RSS 与板端剩余内存。
#
# --- 可选：RabbitMQ / MinIO ---
# 当前 yudao-mini 启动不依赖 RabbitMQ；文件存储配置保存在数据库 infra_file_config，
# 不在本文件中读取。如后续需要，可按仓库根 .env.remote.example 追加：
# YUDAO_RABBITMQ_HOST=192.168.0.23
# YUDAO_RABBITMQ_PORT=5672
# YUDAO_RABBITMQ_USERNAME=rabbit
# YUDAO_RABBITMQ_PASSWORD=rabbit
