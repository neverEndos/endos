# 开发机部署配置模板（由 deploy/release.sh 读取）
#
# 用法：复制为 deploy/deploy.env 后按实际环境修改。
#   cp deploy/deploy.env.example deploy/deploy.env
#
# 注意：
# 1. deploy.env 已被 deploy/.gitignore 忽略，禁止提交到仓库。
# 2. 本文件只保留开发/联调占位值，真实密码与私钥不得写入仓库。
# 3. CLI 参数（--host/--user/--port/--key/--sudo-password）优先于本文件。
# 4. sudo 密码仅用于开发联调；生产环境应给板端配置 sudoers 规则或人工输入。

# 板端 SSH 地址
BOARD_HOST=192.168.0.105
BOARD_USER=alientek
BOARD_PORT=22

# 本机 SSH 私钥路径；留空则使用 ssh 默认查找顺序
SSH_KEY=~/.ssh/id_rsa

# 可选：板端 sudo 密码。仅用于 release.sh 非交互执行（sudo -S）。
# 留空时 release.sh 会用 ssh -t 让开发者交互输入 sudo 密码。
# 仅限 dev 环境使用，禁止提交真实密码。
BOARD_SUDO_PASSWORD=
