# 复制为 .env 后修改全部 CHANGE_ME 与板端地址；.env 权限应为 0600，禁止提交。
TZ=Asia/Shanghai
WEB_PORT=80

POSTGRES_DB=ruoyi-vue-pro
POSTGRES_USER=yudao
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_PORT=5432

REDIS_PASSWORD=CHANGE_ME_REDIS
SPRING_DATA_REDIS_DATABASE=0

MINIO_ROOT_USER=yudao_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
MINIO_BUCKET=yudao
MINIO_ENDPOINT=http://minio:9000
# 浏览器访问 MinIO 签名地址的同源入口，末尾必须包含 /<bucket>，不要以 / 结尾。
# 非 80 端口时必须包含端口，例如 http://192.168.0.101:8080/minio/yudao。
MINIO_PUBLIC_DOMAIN=http://192.168.0.101/minio/yudao
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS="-Xms512m -Xmx1024m -XX:MaxMetaspaceSize=256m -XX:+UseSerialGC -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8"
SERVER_ADDRESS=0.0.0.0
YUDAO_SECURITY_MOCK_ENABLE=false
YUDAO_CAPTCHA_ENABLE=false
YUDAO_ACCESS_LOG_ENABLE=false
SPRING_DATASOURCE_DYNAMIC_DRUID_POOL_PREPARED_STATEMENTS=false
SPRING_DATASOURCE_DYNAMIC_DRUID_MAX_POOL_PREPARED_STATEMENT_PER_CONNECTION_SIZE=0

# 板端显式目录；修改后须自行创建目录并保证容器用户可读写。
SQL_DIR=/opt/yudao/sql/postgresql
POSTGRES_DATA_DIR=/opt/yudao/data/postgres
REDIS_DATA_DIR=/opt/yudao/data/redis
MINIO_DATA_DIR=/opt/yudao/data/minio
BACKEND_RELEASES_DIR=/opt/yudao/releases/backend
WEB_RELEASES_DIR=/opt/yudao/releases/web
BACKUP_DIR=/opt/yudao/backups
